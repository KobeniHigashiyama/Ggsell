APP_NAME=GgSell
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ggsell
DB_USERNAME=ggsell
DB_PASSWORD=secret

# Заглушки поставщиков вызываются по настоящему HTTP через nginx — так таймауты
# реальные, а не сымитированные внутри процесса.
SUPPLIER_BASE_URL=http://web/api
SUPPLIER_TIMEOUT=2
SUPPLIER_CONNECT_TIMEOUT=1
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_BASE_MS=200
SUPPLIER_BACKOFF_MAX_MS=2000
SUPPLIER_BREAKER_THRESHOLD=5
SUPPLIER_BREAKER_COOLDOWN=30

# Доли сбоев заглушек. Тесты переопределяют их принудительным режимом через
# заголовок X-Chaos-Mode, чтобы быть детерминированными.
STUB_A_ERROR_RATE=0.25
STUB_A_TIMEOUT_RATE=0.25
STUB_A_HANG_SECONDS=6
STUB_B_ERROR_RATE=0.10
STUB_B_TIMEOUT_RATE=0.10
STUB_B_HANG_SECONDS=6

# Сколько ждём, прежде чем считать заказ «зависшим» и дожимать его фоном.
ORDER_STUCK_AFTER_SECONDS=60


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Собственный адрес API для команд воспроизведения (внутри docker-сети).
SELF_BASE_URL=http://web/api
