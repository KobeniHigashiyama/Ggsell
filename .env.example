APP_NAME=GgSell
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ggsell
DB_USERNAME=ggsell
DB_PASSWORD=secret

# Supplier stubs are called over real HTTP through nginx so timeouts are real
# rather than simulated inside the process.
SUPPLIER_BASE_URL=http://web/api
SUPPLIER_TIMEOUT=2
SUPPLIER_CONNECT_TIMEOUT=1
SUPPLIER_MAX_ATTEMPTS=3
SUPPLIER_BACKOFF_BASE_MS=200
SUPPLIER_BACKOFF_MAX_MS=2000
SUPPLIER_BREAKER_THRESHOLD=5
SUPPLIER_BREAKER_COOLDOWN=30

# Refuse a code the supplier will not attribute to a product.
SUPPLIER_REQUIRE_CODE_PROVENANCE=true

# Requests per minute each supplier accepts. The core paces itself to this and
# the stubs answer 429 if it ever gets it wrong.
SUPPLIER_A_RATE_PER_MINUTE=30
SUPPLIER_B_RATE_PER_MINUTE=30
SUPPLIER_RATE_LIMIT_RETRY_SECONDS=5

# Share of each supplier window kept for deliveries; audits use the rest.
SUPPLIER_DELIVERY_RESERVE_SHARE=0.5

# Supplier stub failure rates. Tests override them with deterministic behavior
# through the X-Chaos-Mode header.
STUB_A_ERROR_RATE=0.25
STUB_A_TIMEOUT_RATE=0.25
STUB_A_HANG_SECONDS=6
STUB_B_ERROR_RATE=0.10
STUB_B_TIMEOUT_RATE=0.10
STUB_B_HANG_SECONDS=6

# Time before an order is considered stuck and retried in the background.
ORDER_STUCK_AFTER_SECONDS=60
# Ceiling on automatic fulfilment runs per order; manual redelivery resets it.
ORDER_MAX_FULFILMENT_RUNS=10
RECOVERY_BATCH_SIZE=50
# How long a payment event without an order stays in the automatic replay window.
# Older events remain visible in reconciliation but stop crowding the sweep.
PAYMENT_REPLAY_WINDOW_HOURS=24

# Payment gateway stub, used for refunds. The timeout stays below the stub hang
# so "money moved but the answer was lost" stays reproducible.
PAYMENT_BASE_URL=http://web/api
PAYMENT_TIMEOUT=2
PAYMENT_CONNECT_TIMEOUT=1
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_STUB_ERROR_RATE=0
PAYMENT_STUB_TIMEOUT_RATE=0
PAYMENT_STUB_HANG_SECONDS=6

# Settlement: how long a paid line may stay undelivered before it is refunded.
SETTLEMENT_GIVE_UP_AFTER_SECONDS=900
SETTLEMENT_BATCH_SIZE=50

# Storefront page size.
SHOWCASE_PAGE_SIZE=24

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Internal API address used by reproduction commands inside the Docker network.
SELF_BASE_URL=http://web/api
